//  Setup: copy this file once per environment you build, into this same folder:
//
//      cp Secrets.xcconfig.template Secrets.Dev.xcconfig
//      cp Secrets.xcconfig.template Secrets.QC.xcconfig
//      cp Secrets.xcconfig.template Secrets.UAT.xcconfig
//      cp Secrets.xcconfig.template Secrets.Production.xcconfig
//
//  Then fill in the value below in each copy. The copies are git-ignored
//  (see .gitignore) and are pulled in by the matching Dev/QC/UAT/Production
